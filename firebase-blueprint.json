{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user ID" },
        "displayName": { "type": "string", "description": "Display name of the user" },
        "email": { "type": "string", "description": "User email address" },
        "photoURL": { "type": "string", "description": "User avatar URL" },
        "lastLoginAt": { "type": "string", "description": "ISO timestamp of last login" }
      },
      "required": ["uid"]
    },
    "SavedArticle": {
      "title": "SavedArticle",
      "description": "Saved news story by user",
      "type": "object",
      "properties": {
        "articleId": { "type": "string", "description": "Article ID" },
        "title": { "type": "string", "description": "Article headline title" },
        "description": { "type": "string", "description": "Summary or description of the article" },
        "image": { "type": "string", "description": "Cover image URL" },
        "source": { "type": "string", "description": "News publication or source name" },
        "sourceUrl": { "type": "string", "description": "Original source URL" },
        "category": { "type": "string", "description": "News category" },
        "publishedAt": { "type": "string", "description": "Publication timestamp" },
        "savedAt": { "type": "string", "description": "Saved timestamp" },
        "verifiedStatus": { "type": "string", "description": "Fact-check or verification status" }
      },
      "required": ["articleId", "title", "savedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection"
    },
    "/users/{userId}/savedArticles/{articleId}": {
      "schema": "SavedArticle",
      "description": "Articles saved by the user"
    }
  }
}
